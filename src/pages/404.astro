---
import Base from "../layouts/Base.astro";
import { morph } from "../lib/shapes";
import { href } from "../i18n/ui";
---

<Base lang="en" title="404" noindex>
  <main id="main" class="page-x mx-auto flex min-h-dvh w-full max-w-[1200px] flex-col items-start justify-center gap-8">
    <div class="shape grid size-40 place-items-center bg-tertiary text-on-tertiary" style={morph("cookie7", "clover4")} aria-hidden="true">
      <span class="text-5xl font-extrabold">404</span>
    </div>
    <div>
      <h1 class="type-display-m">Nothing here.</h1>
      <p class="mt-2 text-on-surface-variant type-headline-s" lang="zh-CN">这里什么也没有。</p>
    </div>
    <div class="flex gap-2">
      <a class="btn-filled state" href={href("en")}>Home</a>
      <a class="btn-tonal state" href={href("zh")} lang="zh-CN">返回首页</a>
    </div>
  </main>
</Base>
