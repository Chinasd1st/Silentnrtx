---
import ThemeToggle from "./react/ThemeToggle";
import { href, routeOf, t, type Lang } from "../i18n/ui";

const { lang } = Astro.props as { lang: Lang };
const u = t(lang);
const route = routeOf(Astro.url.pathname);
const section = route.startsWith("contact")
  ? "contact"
  : route.startsWith("about")
    ? "about"
    : route.startsWith("gallery")
      ? "gallery"
      : route === ""
        ? "home"
        : "";
const items = [
  { id: "home", label: u.nav.home, to: "" },
  { id: "about", label: u.nav.about, to: "about/" },
  { id: "gallery", label: u.nav.gallery, to: "gallery/" },
  { id: "contact", label: u.nav.contact, to: "contact/" },
] as const;
const langs = [
  { id: "en", label: "EN", short: "EN", hreflang: "en" },
  { id: "zh", label: "中文", short: "中", hreflang: "zh-CN" },
] as const;
const other = langs.find((l) => l.id !== lang)!;
---

<!--
  One row on every screen size.
  Phones: the "Silentnrtx" wordmark is dropped (首页 / Home is the first nav item), the nav
  scrolls sideways if it ever runs out of room, and the EN | 中文 switch becomes a single
  button that jumps to the other language.

  .drop = entrance: each item fades in from above, staggered by --i (first full load only).
  Sliding indicators: only the active item renders a pill, and every page gives it the same
  view-transition-name, so on navigation the browser glides it from the old item to the new one.
-->
<header class="topbar sticky top-0 z-40" transition:animate="none">
  <div class="topbar-row page-x mx-auto flex h-16 max-w-[1200px] items-center gap-x-1">
    <a href={href(lang)} class="topbar-link drop mr-auto hidden h-16 items-center type-title-m sm:flex" style="--i: 0" lang="en">
      Silentnrtx
    </a>

    <nav aria-label={u.nav.label} class="topbar-nav -ml-2.5 mr-auto flex min-w-0 gap-0.5 sm:ml-0 sm:mr-3 sm:gap-1">
      {
        items.map((i, n) => (
          <a href={href(lang, i.to)} class="nav-link drop" style={`--i: ${n + 1}`} aria-current={section === i.id ? "page" : undefined}>
            {section === i.id && <span class="nav-pill" aria-hidden="true" />}
            <span class="vt-label" style={`view-transition-name: nav-${i.id}`}>{i.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="segmented drop hidden sm:inline-flex" style={`--i: ${items.length + 1}`} role="group" aria-label={u.lang.label}>
      {
        langs.map((l) => (
          <a
            href={href(l.id, route)}
            hreflang={l.hreflang}
            lang={l.hreflang}
            data-set-lang={l.id}
            aria-current={lang === l.id ? "true" : undefined}
          >
            {lang === l.id && <span class="seg-pill" aria-hidden="true" />}
            <span class="vt-label" style={`view-transition-name: lang-${l.id}`}>{l.label}</span>
          </a>
        ))
      }
    </div>

    <a
      href={href(other.id, route)}
      class="lang-mini drop sm:hidden"
      style={`--i: ${items.length + 1}`}
      hreflang={other.hreflang}
      lang={other.hreflang}
      data-set-lang={other.id}
      aria-label={`${u.lang.label}: ${other.label}`}
    >
      {other.short}
    </a>

    <div class="topbar-toggle drop -mr-2 size-10 shrink-0 sm:ml-1" style={`--i: ${items.length + 2}`}>
      <ThemeToggle client:only="react" labels={u.theme} />
    </div>
  </div>
</header>
