# ========================
# Silentnrtx Homepage — 环境变量配置
# ========================
# ⚠️ 所有 NEXT_PUBLIC_* 变量在构建时会被嵌入到 JS 文件中，
# 浏览器端可以直接查看。请勿放置敏感密钥。
# 这些 Key 均为只读公开 API，风险可控。
# ========================

# Last.fm API — 获取听歌记录
# https://www.last.fm/api/account/create
NEXT_PUBLIC_LAST_FM_API_KEY=
NEXT_PUBLIC_LAST_FM_USERNAME=silentnrtx

# Steam Web API — 游戏状态（可选）
# https://steamcommunity.com/dev/apikey
NEXT_PUBLIC_STEAM_API_KEY=

# WakaTime — 编码统计（需后端代理解决 CORS）
NEXT_PUBLIC_WAKATIME_API_KEY=
